{
  "manifestVersion": 1,
  "publisher": "hewenyu",
  "name": "cps-block-ua",
  "displayName": "CPS UA 访问控制",
  "version": "0.1.0",
  "description": "检查入站 User-Agent，观察或拒绝不符合 Codex 客户端规则的请求。",
  "license": "MIT",
  "engines": { "codex-proxy-rs": "=3.14.1" },
  "main": "bin/cps-block-ua",
  "runtime": "trustedProcess",
  "contributes": {
    "middleware": {
      "stages": ["request"],
      "inputFormats": ["openai"],
      "outputFormats": ["openai"]
    }
  },
  "permissions": ["requests"],
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "title": "执行模式",
        "description": "observe 记录不匹配事件并放行；enforce 拒绝不匹配请求。",
        "type": "string",
        "enum": ["observe", "enforce"],
        "default": "observe"
      },
      "allow_patterns": {
        "title": "UA 允许规则",
        "description": "Rust regex 语法，大小写敏感，整条 UA 完整匹配；设置后替换默认规则。",
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "default": ["(?:codex_cli_rs|codex-cli|codex-tui|codex_exec|codex_vscode|Codex Desktop)/[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?(?: [ -~]*)?"]
      },
      "allow_models": {
        "title": "放行模型查询",
        "description": "仅豁免 /v1/models 和 /v1/models/{id} 的 UA 检查，CPS Key 认证仍然生效。",
        "type": "boolean",
        "default": true
      }
    }
  }
}
